  "components": {
    "schemas": {
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identificador único da categoria (gerado automaticamente)"
          },
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100,
            "example": "Eletrônicos",
            "description": "Nome da categoria (obrigatório, 3-100 caracteres, único)"
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "example": "Produtos eletrônicos variados",
            "description": "Descrição da categoria (obrigatório, até 500 caracteres)"
          },
          "slug": {
            "type": "string",
            "example": "eletronicos",
            "description": "Slug gerado do nome da categoria (gerado automaticamente)"
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "example": 1
          },
          "totalPages": {
            "type": "integer",
            "example": 5
          },
          "total": {
            "type": "integer",
            "example": 47
          }
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identificador único do produto (gerado automaticamente)"
          },
          "name": {
            "type": "string",
            "minLength": 6,
            "maxLength": 40,
            "pattern": "^[a-zA-ZÀ-ÿ\\s]+$",
            "example": "Mouse Gamer RGB Pro Wireless",
            "description": "Nome completo do produto (obrigatório, 6-40 caracteres, sem números ou caracteres especiais, sem espaços duplicados, único)"
          },
          "price": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 999999.99,
            "multipleOf": 0.01,
            "example": 299.9,
            "description": "Preço de venda do produto (obrigatório, valor > 0, máximo 999999.99, 2 casas decimais)"
          },
          "stock_quantity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999,
            "example": 50,
            "description": "Quantidade em estoque (obrigatório, número inteiro, 0-999)"
          },
          "sku": {
            "type": "string",
            "minLength": 5,
            "maxLength": 20,
            "pattern": "^[A-Z][A-Z0-9\\-]*$",
            "example": "MGP-2024W",
            "description": "SKU do produto (obrigatório, 5-20 caracteres, inicia com letra maiúscula, apenas letras maiúsculas, números e hífen, único)"
          },
          "category_id": {
            "type": "integer",
            "minimum": 1,
            "description": "ID da categoria (obrigatório, deve existir na tabela categories)"
          },
          "supplier_id": {
            "type": "integer",
            "minimum": 1,
            "description": "ID do fornecedor (obrigatório, deve existir na tabela suppliers)"
          },
          "slug": {
            "type": "string",
            "example": "mouse-gamer-rgb-pro-wireless",
            "description": "Slug gerado do nome do produto (gerado automaticamente)"
          },
          "is_active": {
            "type": "boolean",
            "description": "Indica se o produto está ativo",
            "default": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Data e hora de criação do produto (gerado automaticamente)"
          },
          "categories": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              }
            }
          },
          "suppliers": {
            "type": "object",
            "properties": {
              "company_name": {
                "type": "string"
              }
            }
          }
        }
      }
    }
